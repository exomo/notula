{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noten",
  "version": "0.1.0",
  "identifier": "dev.noten.app",
  "build": {
    "beforeDevCommand": "npm run dev -w ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build -w ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Noten",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
